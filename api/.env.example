# DeepSeek API key（必填）
DEEPSEEK_API_KEY=sk-xxx
# 模型：deepseek-chat (V3，快) 或 deepseek-reasoner (R1，深度思考)
DEEPSEEK_MODEL=deepseek-chat
# Base URL（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 监听端口（Nginx 反代到这里）
PORT=3100
# 速率限制：每个 IP 每天最多调用次数（AI 分析）
RATE_LIMIT_PER_DAY=10

# ── 收集本（老师后端回收作答）──
# 作答数据落盘目录（默认 <api cwd>/data，即 api/data）。务必在 /api 反代后面，别指向静态 out/
# DATA_DIR=./data
# 收集端点限流（滑动 24h/IP）：作答提交额度高（一场活动家长可能共用出口 IP），创建收集本额度低
COLLECT_SUBMIT_LIMIT_PER_DAY=300
COLLECT_CREATE_LIMIT_PER_DAY=50
